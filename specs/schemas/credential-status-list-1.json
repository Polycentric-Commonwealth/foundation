{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polycentric-commonwealth/foundation/specs/schemas/credential-status-list-1.json",
  "title": "credential-status-list/1",
  "description": "A State's revocation bits for one list of credentials: one bit per entry, most significant bit first, gzip compressed, unpadded base64url.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "list",
    "size",
    "revoked"
  ],
  "properties": {
    "list": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "revoked": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
