{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polycentric-commonwealth/foundation/specs/schemas/uniqueness-evaluation-request-1.json",
  "title": "uniqueness-evaluation-request/1",
  "description": "A State's blinded elements for one operator to evaluate. Sent to the operator's evaluation endpoint, never logged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epoch",
    "elements"
  ],
  "properties": {
    "epoch": {
      "$ref": "#/$defs/epoch"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "$defs": {
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "element": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
