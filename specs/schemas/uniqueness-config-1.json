{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polycentric-commonwealth/foundation/specs/schemas/uniqueness-config-1.json",
  "title": "uniqueness-config/1",
  "description": "The uniqueness configuration: the OPRF suite, key epoch, Feldman commitments (their number is the threshold), operators and registry. Published and logged by the Commonwealth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite",
    "epoch",
    "commitments",
    "operators",
    "registry"
  ],
  "properties": {
    "suite": {
      "const": "ristretto255-SHA512"
    },
    "epoch": {
      "$ref": "#/$defs/epoch"
    },
    "commitments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance",
          "index"
        ],
        "properties": {
          "instance": {
            "$ref": "#/$defs/instance"
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        }
      }
    },
    "registry": {
      "$ref": "#/$defs/instance"
    }
  },
  "$defs": {
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "element": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$",
      "maxLength": 253
    }
  }
}
