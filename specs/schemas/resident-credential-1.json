{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polycentric-commonwealth/foundation/specs/schemas/resident-credential-1.json",
  "title": "resident-credential/1",
  "description": "A State's statement that the holder of a key has the listed claims, for one audience. Carried by the holder; never addressed, sent to an inbox or logged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "holder",
    "audience",
    "claims",
    "valid_from",
    "valid_until"
  ],
  "properties": {
    "holder": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "audience": {
      "$ref": "#/$defs/instance"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "adult",
          "dividend-eligible",
          "resident"
        ]
      }
    },
    "valid_from": {
      "$ref": "#/$defs/time"
    },
    "valid_until": {
      "$ref": "#/$defs/time"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list",
        "index"
      ],
      "properties": {
        "list": {
          "$ref": "#/$defs/list"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048575
        }
      }
    }
  },
  "$defs": {
    "instance": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$",
      "maxLength": 253
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "list": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    }
  }
}
