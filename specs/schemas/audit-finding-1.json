{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polycentric-commonwealth/foundation/specs/schemas/audit-finding-1.json",
  "title": "audit-finding/1",
  "description": "The outcome of an eligibility audit: totals only. repayment = estimated_excess × per_person × multiplier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["count", "request", "sampled", "unverified", "estimated_excess", "unit", "per_person", "multiplier", "repayment"],
  "properties": {
    "count": { "$ref": "#/$defs/id" },
    "request": { "$ref": "#/$defs/id" },
    "sampled": { "type": "integer", "minimum": 1, "maximum": 600 },
    "unverified": { "type": "integer", "minimum": 0, "maximum": 600 },
    "estimated_excess": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "unit": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "per_person": { "$ref": "#/$defs/amount" },
    "multiplier": { "$ref": "#/$defs/amount" },
    "repayment": { "$ref": "#/$defs/amount" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$" }
  }
}
